# ==========================================
# SMART ATTENDANCE SYSTEM - ENVIRONMENT CONFIG
# ==========================================

# Django Core
DEBUG=True
SECRET_KEY=django-insecure-smart-face-attendance-system-key-2026
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Default is SQLite for zero-setup localhost execution (db.sqlite3).
# To use PostgreSQL, set DATABASE_URL or POSTGRES_* credentials:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_attendance_db

# WebSocket Channel Layer & Cache
# Default uses channels.layers.InMemoryChannelLayer for zero-setup localhost execution.
# To use Redis daemon:
# REDIS_URL=redis://localhost:6379/0

# JWT Lifetimes
JWT_ACCESS_HOURS=12
JWT_REFRESH_DAYS=7

# Biometric Face Recognition Configuration
# Distance tolerance (0.4 to 0.7; default 0.60, lower is stricter)
FACE_MATCH_THRESHOLD=0.60
# Duplicate check-in cooldown in seconds
RECOGNITION_COOLDOWN_SECONDS=30
# Face recognition provider: 'real' (production OpenCV/face_recognition) or 'development' (deterministic mock)
FACE_RECOGNITION_PROVIDER=real

# Frontend / CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
